# Conexão de MIGRAÇÃO — papel dono do schema, executa DDL.
DATABASE_URL_OWNER=postgres://mecanix_owner:owner@localhost:5432/mecanix

# Conexão de RUNTIME — papel da aplicação: NOBYPASSRLS, sem DDL, não é dono
# de nenhuma tabela. É esta que a aplicação usa. Nunca aponte a aplicação
# para a conexão de migração: o dono da tabela contorna a RLS.
DATABASE_URL=postgres://mecanix_app:app@localhost:5432/mecanix

# Conexão de superusuário — usada só pelo bootstrap que cria os dois papéis.
DATABASE_URL_SUPERUSER=postgres://postgres:postgres@localhost:5432/mecanix
